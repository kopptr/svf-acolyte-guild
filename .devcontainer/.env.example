# Copy of this file lives at .devcontainer/.env (gitignored) and is loaded
# into the container as environment variables via --env-file in
# devcontainer.json. It's created automatically from this template the
# first time you build the container, so you only need to come back here
# and uncomment/fill in what you actually use. Changes require a container
# rebuild to take effect (same as any other devcontainer.json change).

# Anthropic API key, if some tool in the container needs direct API access
# outside of Claude Code's normal browser login:
# ANTHROPIC_API_KEY=

# Cloud-hosted model provider credentials — see DEVCONTAINER.md's Security
# notes and https://code.claude.com/docs/en/devcontainer for specifics:
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Any other project-specific secret:
# MY_API_KEY=
